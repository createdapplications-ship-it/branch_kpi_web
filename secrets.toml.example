# Copy these three lines into the Secrets box of the hosted app (or into .streamlit/secrets.toml on a PC).
# Never upload the real values to GitHub.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
ADMIN_USERNAME = "owner"
ADMIN_PASSWORD = "choose-a-strong-password-1"
# LOAD_SAMPLE_DATA = "false"   # add this line to start with no sample entries
# APP_TIMEZONE = "Asia/Manila"   # time zone used to show attendance times
# PORTAL_NAME = "Company Portal"   # title of the main page
